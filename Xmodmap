remove Lock = Caps_Lock
keysym Caps_Lock = Control_L
add Control = Control_L

! Spanish remaps
! Eñe!
keycode 57 = n N U00f1 U00d1 U00f1 U00d1

! Remap vowels to their accented counterparts when pressing AltGr
keycode 38 = a A aacute Aacute aacute Aacute
keycode 26 = e E eacute Eacute eacute Eacute
keycode 31 = i I iacute Iacute iacute Iacute
keycode 32 = o O oacute Oacute oacute Oacute
keycode 30 = u U uacute Uacute uacute Uacute

! braces and brackets over parens buttons
keycode  18 = 9 parenleft bracketleft braceleft bracketleft braceleft
keycode  19 = 0 parenright bracketright braceright bracketright braceright
